# ---------------------------
# Maven Wrapper - keep these files!
# ---------------------------
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# Ignore everything in .mvn except wrapper
.mvn/*
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

